RewriteEngine On
DirectoryIndex index.html index.php

# Skip rewrite for anything under /el_prihlaska/
RewriteCond %{REQUEST_URI} ^/el_prihlaska/ [NC]
RewriteRule ^ - [L]

# The old site stays under /old/, reached only by typing the address (no links to it).
# Search engines get noindex (below) and drop it. Visitors coming from other sites (search
# results, links) go to the new web; without a Referer (typed address, bookmark, crawlers)
# or from our own pages the old site opens. 302, so browsers don't remember the redirect
# and a typed /old/ keeps working.
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_HOST}@@%{HTTP_REFERER} !^([^@]+)@@https?://\1/ [NC]
RewriteRule ^old(/.*)?$ / [R=302,L,QSD]

# Addresses from when the old site was in the root: index.php?stranka=… → the new page.
RewriteCond %{QUERY_STRING} (^|&)stranka=historie(&|$)
RewriteRule ^index\.php$ /historie [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)stranka=(pridej_se|formular|registrace)(&|$)
RewriteRule ^index\.php$ /cekaci-listina [R=301,L,QSD]
RewriteRule ^index\.php$ / [R=301,L,QSD]

# --- Countdown (launch.html), off since launch — docs/DEPLOY.md "Countdown" ---
# To show it to everyone again (e.g. during bigger changes), uncomment the four lines
# below and upload .htaccess. Visitors get launch.html with status 503 (search engines
# keep the site's pages in their index); a browser with the preview cookie sees the web:
# ?nahled=1 turns it on for 30 days, ?nahled=0 off.
RewriteCond %{QUERY_STRING} (^|&)nahled=1(&|$)
RewriteRule ^ %{REQUEST_URI}? [CO=nahled:1:%{SERVER_NAME}:43200:/:secure:httponly,R=302,L]
RewriteCond %{QUERY_STRING} (^|&)nahled=0(&|$)
RewriteRule ^ %{REQUEST_URI}? [CO=nahled:0:%{SERVER_NAME}:-1:/:secure:httponly,R=302,L]

ErrorDocument 503 /launch.html
# RewriteCond %{HTTP_COOKIE} !(^|;\s*)nahled=1(;|$)
# RewriteCond %{REQUEST_URI} !^/(old|el_prihlaska|skautis)(/|$) [NC]
# RewriteCond %{REQUEST_URI} !^/(launch\.html|rozcestnik-800\.webp|favicon\.(ico|svg)|apple-touch-icon\.png)$
# RewriteRule ^ - [R=503,L]
# --- end countdown ---

# Public pages with their own static HTML (scripts/static-pages.js): /historie → historie.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)$ /$1.html [L]

# The web app: paths that aren't files go to index.html (Vue Router, history mode).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Pages change with each upload (and with the preview cookie); assets have hashed names.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/launch\.html$#">
    Header set X-Robots-Tag "noindex"
  </If>
  <If "%{REQUEST_URI} =~ m#^/old(/|$)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
