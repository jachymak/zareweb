rules_version = '2';

// Access rules — see docs/SPEC.md §5.1.
// Roles live in users/{uid}.role: pending | parent | leader | admin | none.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasRole(roles) {
      return signedIn() && exists(userPath()) && get(userPath()).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isLeader() {
      return hasRole(['leader', 'admin']);
    }

    function isApproved() {
      return hasRole(['parent', 'leader', 'admin']);
    }

    function member(memberId) {
      return get(/databases/$(database)/documents/members/$(memberId)).data;
    }

    function isParentOf(memberId) {
      return hasRole(['parent']) && request.auth.uid in member(memberId).parentUids;
    }

    // End of the deadline day in Europe/Prague, approximated as 22:00 UTC
    // (midnight CEST; one hour early in winter).
    function beforeDeadline(deadline) {
      return request.time < timestamp.date(
        int(deadline[0:4]), int(deadline[5:7]), int(deadline[8:10])
      ) + duration.value(22, 'h');
    }

    // ---- users ----

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isLeader();

      function validNote(note) {
        return note == null || (note is string && note.size() <= 1000);
      }

      // Self-registration always starts as pending.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validNote(request.resource.data.note)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'note', 'createdAt']);

      // A pending user may fill in the note for the admin (e.g. after a Google login).
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && resource.data.role == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'note'])
            && validNote(request.resource.data.note));

      allow delete: if isAdmin();
    }

    // ---- members (children, imported from skautIS) ----

    match /members/{memberId} {
      allow read: if isLeader() || (hasRole(['parent']) && request.auth.uid in resource.data.parentUids);
      allow write: if isAdmin();

      match /private/{docId} {
        allow read: if isLeader();
        allow write: if isAdmin();
      }
    }

    // Parent invitations sent from Administration (inviteParent only).
    match /invitations/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // skautIS data loaded by previewSkautisSync, waiting to be applied (functions only).
    match /skautisSync/{docId} {
      allow read, write: if false;
    }

    match /skautisPeople/{personId} {
      allow read: if isApproved();
      allow write: if isAdmin();

      // Birthdays from the skautIS export (directory, SPEC §4.10) — not for parents.
      match /private/{docId} {
        allow read: if isLeader();
        allow write: if isAdmin();
      }
    }

    // ---- the leaders' directory in the phone (CardDAV, SPEC §4.10) ----

    // Chosen groups; passwordSetAt is written by createPhonePassword.
    match /phoneContacts/{uid} {
      allow read: if isLeader() && request.auth.uid == uid;
      allow create, update: if isLeader() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groups', 'passwordSetAt'])
        && (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups']))
        && (resource != null || !('passwordSetAt' in request.resource.data))
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 6;
    }

    // Contacts outside the troop shared by all leaders („ostatní“, e.g. the mayor near the camp).
    match /sharedContacts/{contactId} {
      function validShared(d) {
        return d.keys().hasOnly(['name', 'description', 'phone', 'email', 'createdBy', 'createdByName', 'createdAt', 'updatedBy', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.description is string && d.description.size() <= 200
          && (d.phone == null || (d.phone is string && d.phone.size() <= 40))
          && (d.email == null || (d.email is string && d.email.size() <= 100))
          && (d.phone != null || d.email != null);
      }
      allow read, delete: if isLeader();
      allow create: if isLeader() && validShared(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isLeader() && validShared(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Hashes of the phone passwords (functions only).
    match /phonePasswords/{uid} {
      allow read, write: if false;
    }

    // ---- attendance ----

    match /meetings/{meetingId} {
      allow read: if isApproved();
      allow write: if isLeader();
    }

    // Excuses from meetings, id `{troop}_{date}_{memberId}`. A parent excuses
    // their own child only on the meeting day and may take it back that day;
    // leaders any time. The child is read from the id, so a parent can also
    // ask for an excuse that doesn't exist (yet).
    match /excuses/{excuseId} {
      function excusedChild() {
        return excuseId.split('_')[2];
      }

      // The day in Europe/Prague, approximated as 22:00 UTC the day before to
      // 22:00 UTC that day (exact in summer, one hour early in winter).
      function onDay(date) {
        return request.time >= timestamp.date(
          int(date[0:4]), int(date[5:7]), int(date[8:10])
        ) - duration.value(2, 'h') && request.time < timestamp.date(
          int(date[0:4]), int(date[5:7]), int(date[8:10])
        ) + duration.value(22, 'h');
      }

      // The day pretended on the dev server (`?dnes=`, src/devToday.js) — written
      // straight into the emulator; nobody can write it in production.
      function devDay(date) {
        return exists(/databases/$(database)/documents/devToday/today)
          && get(/databases/$(database)/documents/devToday/today).data.date == date;
      }

      allow read: if isLeader() || isParentOf(excusedChild());
      allow write: if isLeader();

      allow create: if isParentOf(request.resource.data.memberId)
        && request.resource.data.keys().hasOnly(['troop', 'date', 'memberId', 'reason', 'by', 'createdBy', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && excuseId == request.resource.data.troop + '_' + request.resource.data.date + '_' + request.resource.data.memberId
        && request.resource.data.troop == member(request.resource.data.memberId).troop
        && request.resource.data.by == 'parent'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && (onDay(request.resource.data.date) || devDay(request.resource.data.date));

      allow delete: if isParentOf(excusedChild())
        && (onDay(resource.data.date) || devDay(resource.data.date));
    }

    match /devToday/{docId} {
      allow read, write: if false;
    }

    // ---- events ----

    match /events/{eventId} {
      allow read: if isLeader() || (isApproved() && resource.data.deleted == false);
      allow create, update: if isLeader();
      // Soft delete only (deleted flag), sign-ups and payments are kept.
      allow delete: if false;

      match /poster/{docId} {
        allow read: if isLeader()
          || (isApproved() && get(/databases/$(database)/documents/events/$(eventId)).data.posterStatus == 'published');
        allow write: if isLeader();
      }

      match /participants/{memberId} {
        function event() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }

        function parentMaySignUp() {
          return isParentOf(memberId)
            && event().deleted == false
            && event().cancelled == false
            && event().registrationOpen == true
            && beforeDeadline(event().registrationDeadline)
            && (event().audience == 'all' || event().audience == member(memberId).troop)
            && request.resource.data.signedUpBy == request.auth.uid
            && request.resource.data.signedUpAt == request.time;
        }

        allow read: if isLeader() || isParentOf(memberId);
        allow write: if isLeader();
        allow create: if parentMaySignUp()
          && request.resource.data.keys().hasOnly(['signedUp', 'signedUpBy', 'signedUpAt']);
        allow update: if parentMaySignUp()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signedUp', 'signedUpBy', 'signedUpAt']);
      }
    }

    // ---- news, contacts, templates, albums ----

    match /news/{newsId} {
      allow read: if isLeader() || (isApproved() && resource.data.withdrawn == false);
      // Author and publication date are set once, by the author; withdrawn news
      // stay (deleted later in bulk, SPEC §4.4).
      allow create: if isLeader()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && request.resource.data.withdrawn == false;
      allow update: if isLeader()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['authorUid', 'authorName', 'publishedAt']);
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /packingTemplates/{templateId} {
      allow read: if isLeader();
      allow write: if isAdmin();
    }

    // Photo albums (SPEC §4.9). Parents see published albums; the photo count
    // and the photos are kept by Cloud Functions, deleting goes through them too.
    match /albums/{albumId} {
      function validAlbum(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.audience in ['vlc', 'ss', 'all']
          && data.startDate is string && data.endDate is string && data.startDate <= data.endDate
          && data.published is bool
          && (!('groupByDay' in data) || data.groupByDay is bool)
          && (data.eventId == null || data.eventId is string);
      }

      allow read: if isLeader() || (isApproved() && resource.data.published == true);
      allow create: if isLeader() && validAlbum(request.resource.data)
        && request.resource.data.photoCount == 0
        && request.resource.data.coverPhotoId == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isLeader() && validAlbum(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['photoCount', 'createdBy', 'createdAt']);
      allow delete: if false;

      match /photos/{photoId} {
        allow read: if isLeader()
          || (isApproved() && get(/databases/$(database)/documents/albums/$(albumId)).data.published == true);
        allow write: if false;
      }
    }

    // ---- waiting list ----
    // Public sign-up, renewal and the annual reset go through Cloud Functions.

    match /waitlist/{entryId} {
      allow read, delete: if isLeader();
      allow update: if isLeader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaderNote']);
    }

    match /waitlistResets/{resetId} {
      allow read: if isLeader();
    }

    // ---- settings ----

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/app {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      // meetings — the schedule is shown on the public home page too.
      allow read: if docId == 'meetings' || (docId in ['emails', 'skautis', 'recorders'] && isLeader());
      allow write: if isAdmin();
    }
  }
}
