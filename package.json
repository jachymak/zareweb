{
  "name": "zareweb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "node e2e/run.js",
    "format": "prettier --write --experimental-cli src/",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "seed": "node --env-file-if-exists=.env scripts/seed-emulator.js",
    "seed:renewal": "node --env-file-if-exists=.env scripts/seed-renewal.js",
    "postinstall": "npm --prefix functions install",
    "seed:users": "node --env-file-if-exists=.env scripts/seed-users.js",
    "seed:members": "node --env-file-if-exists=.env scripts/seed-members.js",
    "seed:activity": "node --env-file-if-exists=.env scripts/seed-activity.js"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "firebase-tools": "^15.31.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
