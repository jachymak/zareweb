# Firebase web app config (Firebase console → Project settings → Your apps).
# For local development with emulators, the demo values below are enough.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-zareweb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-zareweb
VITE_FIREBASE_STORAGE_BUCKET=demo-zareweb.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Connect to local Firebase emulators (npm run emulators). Set to false for a real project.
VITE_USE_EMULATORS=true
